cts rares (avertissement)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=top;spacing=0;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1276" y="302" width="334" height="325" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;arrowWidth=0.45;arrowSize=0.3;" vertex="1" parent="1"><mxGeometry x="1660" y="375" width="90" height="50" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1760" y="0" width="320" height="660" as="geometry"/></mxCell><mxCell id="c39" value="Utilisation" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#ffffff;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1845" y="-20" width="150" height="40" as="geometry"/></mxCell><mxCell id="c40" value="Exports JSON&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;&lt;font face=&#x27;monospace&#x27;&gt;export.py&lt;/font&gt;&lt;/span&gt;" style="shape=image;html=1;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=15;fontStyle=1;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1892" y="40" width="56" height="70" as="geometry"/></mxCell><mxCell id="c41" value="&lt;span style=&#x27;font-weight:normal&#x27;&gt;publiés chaque matin&lt;/span&gt;" style="shape=image;html=1;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fontSize=15;fontStyle=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1865" y="195" width="110" height="75" as="geometry"/></mxCell><mxCell id="c42" value="Portfolio&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;station la moins chère&lt;br&gt;autour de soi&lt;/span&gt;" style="shape=image;html=1;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;fon